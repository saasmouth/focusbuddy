<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened Runtime entitlements required to notarise an Electron app.
       Chromium's V8 JITs JavaScript, which needs the JIT + unsigned-executable-
       memory exceptions, and our native modules (better-sqlite3,
       node-mac-haptics, and node-llama-cpp's llama.cpp binding, which is the
       on-device AI engine) are separately signed dylibs the app dlopen()s,
       which needs library-validation disabled. Without these, a hardened-runtime build
       either fails to launch or fails notarisation. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <!-- The app records voice/video notes; the microphone + camera entitlements
       let a hardened-runtime build request those devices at runtime. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.device.camera</key>
  <true/>
</dict>
</plist>

{
  "manifest_version": "0.2",
  "name": "plexii",
  "display_name": "Plexii",
  "version": "1.0.0",
  "description": "Search, read and add to your local Plexii workspace from Claude Desktop.",
  "long_description": "Connects Claude Desktop to the Plexii running on this machine. Search and read desks, work items, documents, tables, knowledge, the calendar and meeting transcripts; with a write token, also add work items, desks, knowledge, documents, table rows and time blocks. Nothing on the surface deletes, sends or reaches outside the machine. Plexii must be running with PlexiiAPI turned on.",
  "author": {
    "name": "Plexii"
  },
  "server": {
    "type": "node",
    "entry_point": "server/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/server/index.js"
      ],
      "env": {
        "PLEXII_MCP_URL": "${user_config.api_url}",
        "PLEXII_API_TOKEN": "${user_config.api_token}"
      }
    }
  },
  "user_config": {
    "api_url": {
      "type": "string",
      "title": "Plexii MCP URL",
      "description": "The local PlexiiAPI endpoint. Loopback only — a non-loopback host is refused at startup.",
      "default": "http://127.0.0.1:8787/mcp",
      "required": true
    },
    "api_token": {
      "type": "string",
      "title": "PlexiiAPI token",
      "description": "From Plexii → PlexiiBrain → APIs. A read token searches and reads; a write token can also add things.",
      "sensitive": true,
      "required": true
    }
  },
  "tools": [
    {
      "name": "plexii_search",
      "description": "Search the workspace"
    },
    {
      "name": "plexii_list_desks",
      "description": "List desks"
    },
    {
      "name": "plexii_read_desk",
      "description": "Read a desk"
    },
    {
      "name": "plexii_list_work_items",
      "description": "List work items"
    },
    {
      "name": "plexii_get_work_item",
      "description": "Read a work item"
    },
    {
      "name": "plexii_list_documents",
      "description": "List documents"
    },
    {
      "name": "plexii_read_document",
      "description": "Read a document"
    },
    {
      "name": "plexii_list_tables",
      "description": "List tables"
    },
    {
      "name": "plexii_table_rows",
      "description": "Read table rows"
    },
    {
      "name": "plexii_list_knowledge",
      "description": "List knowledge"
    },
    {
      "name": "plexii_list_templates",
      "description": "List templates"
    },
    {
      "name": "plexii_list_wires",
      "description": "List wires on a desk"
    },
    {
      "name": "plexii_list_meetings",
      "description": "List meetings"
    },
    {
      "name": "plexii_list_reports",
      "description": "List reports"

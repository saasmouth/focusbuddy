# Agentic-kit artifacts (live alongside the app source but are not part of the app)
manifest.json
# ...except the Claude Desktop extension manifest, which IS part of the app: it is
# shipped with the MCP bridge, and tests/unit/mcpServer.test.ts pins its tool list
# against WORKSPACE_TOOLS. Ignored, it existed only in whichever checkout last ran
# gen-manifest.mjs, so every fresh worktree failed that test (and the pre-push hook).
!tools/plexii-mcp-bridge/manifest.json
brief.md
POSITIONING.md
COPY-PACKAGE.md
LANDING-PAGE.md
engagements/
outputs/
sources/

# Dev-only mock assets — served via the fb-dev:// protocol in development.
# Kept on disk locally but excluded from version control because the videos
# are large (the working webcam placeholder alone is ~190 MB).
Mock Videos/
release/
release-office/

# Marketing assets stay LOCAL — never committed to the app repo. The folder holds
# the brief, real screenshots, ad copy, finished ad creatives, and the landing
# page (large binaries + a working copy). The screenshot-capture spec is a
# marketing-only tool, so it's excluded too.
marketing/
tests/e2e/captureMarketingShots.spec.ts

# Stray Windows release-artifact download dirs (installers exceed GitHub 100MB)
win-artifact/
win[0-9]*/

# Side-by-side preview build output (dist:preview)
release-preview/

# Throwaway self-signed TLS cert for the local org-sync live-proxy test helper
tests/e2e/support/localhost-key.pem
tests/e2e/support/localhost-cert.pem
build/spec-trace.report.json

# Generated by tests/unit/plxPerfBudgets.test.ts on every unit run (F-001 side effect:
# that test could not load before, so this artifact never appeared).
build/perf.report.json
release-local/

# Stray root-level bundle output; the real compiled entry lives under out/.
/index.js
